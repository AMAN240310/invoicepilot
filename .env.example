# InvoicePilot Configuration

# Server
PORT=3001
HOST=localhost
NODE_ENV=development

# Storage paths (relative to server directory or absolute)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DB_PATH=./data/invoicepilot.db

# Upload Limits
MAX_FILE_SIZE_BYTES=10485760 # 10MB
MAX_FILES_PER_BATCH=10

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b-it-qat
# Alternative models: gemma:2b, llama3.2, etc.
OLLAMA_TIMEOUT_MS=60000

# Mock Mode (Set to true to use deterministic mock extraction for testing/demo without Ollama)
MOCK_AI_MODE=false
